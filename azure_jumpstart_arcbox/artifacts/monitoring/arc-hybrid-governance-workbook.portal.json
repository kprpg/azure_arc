        {
            "type": 12,
            "content": {
                "version": "NotebookGroup/1.0",
                "groupType": "editable",
                "title": "Executive Summary",
                "items": [
                    {
                        "type": 3,
                        "content": {
                            "version": "KqlItem/1.0",
                            "query": "let MachineInventory = Resources\n| where type in~ (\u0027microsoft.hybridcompute/machines\u0027,\u0027microsoft.compute/virtualmachines\u0027)\n| where \u0027*\u0027 in ({Subscription}) or subscriptionId in ({Subscription})\n| where \u0027*\u0027 in ({ResourceGroup}) or resourceGroup in ({ResourceGroup})\n| extend Scope = iff(type =~ \u0027microsoft.hybridcompute/machines\u0027, \u0027Arc\u0027, \u0027AzureVM\u0027)\n| extend OSTypeNorm = tolower(coalesce(tostring(properties.osName), tostring(properties.osType), tostring(properties.storageProfile.osDisk.osType)))\n| where \u0027*\u0027 in ({MachineScope}) or Scope in ({MachineScope})\n| where \u0027All\u0027 in ({OSType}) or (\u0027Windows\u0027 in ({OSType}) and OSTypeNorm has \u0027windows\u0027) or (\u0027Linux\u0027 in ({OSType}) and OSTypeNorm has \u0027linux\u0027);\nlet TotalMachines = toscalar(MachineInventory | summarize c = count());\nlet ReportingMachines = toscalar(Heartbeat | where TimeGenerated \u003e ago(15m) | summarize c = dcount(Computer));\nlet MissingUpdates = toscalar(union isfuzzy=true UpdateSummary | extend Missing = tolong(column_ifexists(\u0027MissingCount\u0027, column_ifexists(\u0027TotalUpdatesMissing\u0027, 0))) | summarize c = sum(Missing));\nlet SqlDetected = toscalar(union isfuzzy=true ConfigurationData | where ConfigDataType == \u0027WindowsServices\u0027 | extend ServiceNameNorm = tostring(coalesce(column_ifexists(\u0027ServiceName\u0027, \u0027\u0027), column_ifexists(\u0027Name\u0027, \u0027\u0027), column_ifexists(\u0027DisplayName\u0027, \u0027\u0027), column_ifexists(\u0027SvcName\u0027, \u0027\u0027))) | where ServiceNameNorm has \u0027MSSQL\u0027 | summarize c = dcount(Computer));\nlet ShadowDbDetected = toscalar(union isfuzzy=true ConfigurationData | where ConfigDataType == \u0027Software\u0027 | extend SoftwareNameNorm = tostring(coalesce(column_ifexists(\u0027SoftwareName\u0027, \u0027\u0027), column_ifexists(\u0027DisplayName\u0027, \u0027\u0027), column_ifexists(\u0027Name\u0027, \u0027\u0027))) | where SoftwareNameNorm has_any (\u0027MySQL\u0027,\u0027Postgre\u0027,\u0027Oracle\u0027,\u0027Mongo\u0027,\u0027Redis\u0027) | summarize c = dcount(Computer));\nprint TotalMachines, ReportingMachines, MissingUpdates, SqlDetected, ShadowDbDetected",
                            "size": 0,
                            "title": "Hybrid KPI Snapshot",
                            "timeContextFromParameter": "timeRange",
                            "queryType": 1,
                            "resourceType": "microsoft.resourcegraph/resources",
                            "crossComponentResources": [
                                "{Workspace}",
                                "{Subscription}"
                            ],
                            "visualization": "tiles",
                            "tileSettings": {
                                "showBorder": false,
                                "titleContent": {
                                    "columnMatch": "TotalMachines",
                                    "formatter": 1
                                },
                                "leftContent": {
                                    "columnMatch": "TotalMachines",
                                    "formatter": 12
                                }
                            }
                        },
                        "name": "exec-kpi"
                    },
                    {
                        "type": 3,
                        "content": {
                            "version": "KqlItem/1.0",
                            "query": "Heartbeat\n| where TimeGenerated \u003e ago(7d)\n| summarize LastHeartbeat = max(TimeGenerated) by Computer, OSType\n| extend Status = iff(LastHeartbeat \u003e ago(15m), \u0027Online\u0027, \u0027Offline\u0027)\n| summarize Machines = count() by Status\n| order by Machines desc",
                            "size": 0,
                            "title": "Online vs Offline",
                            "timeContextFromParameter": "timeRange",
                            "queryType": 0,
                            "resourceType": "microsoft.operationalinsights/workspaces",
                            "crossComponentResources": [
                                "{Workspace}"
                            ],
                            "visualization": "piechart"
                        },
                        "customWidth": "50",
                        "name": "exec-online"
                    },
                    {
                        "type": 3,
                        "content": {
                            "version": "KqlItem/1.0",
                            "query": "union isfuzzy=true UpdateSummary\n| extend Installed = tolong(column_ifexists(\u0027InstalledCount\u0027, 0)), Missing = tolong(column_ifexists(\u0027MissingCount\u0027, column_ifexists(\u0027TotalUpdatesMissing\u0027, 0)))\n| summarize Installed = sum(Installed), Missing = sum(Missing) by Computer\n| extend CompliancePercent = iff((Installed + Missing) == 0, real(null), round(100.0 * todouble(Installed) / todouble(Installed + Missing), 2))\n| summarize AvgCompliance = round(avg(CompliancePercent), 2)\n| project [\u0027Average Patch Compliance %\u0027] = coalesce(AvgCompliance, 0.0)",
                            "size": 0,
                            "title": "Average Patch Compliance",
                            "timeContextFromParameter": "timeRange",
                            "queryType": 0,
                            "resourceType": "microsoft.operationalinsights/workspaces",
                            "crossComponentResources": [
                                "{Workspace}"
                            ],
                            "visualization": "table"
                        },
                        "customWidth": "50",
                        "name": "exec-compliance"
                    }
                ]
            },
            "conditionalVisibility": {
                "parameterName": "selectedTab",
                "comparison": "isEqualTo",
                "value": "Executive"
            },
            "name": "tab-executive"
        },
        {
            "type": 12,
            "content": {
                "version": "NotebookGroup/1.0",
                "groupType": "editable",
                "title": "Hybrid Inventory",
                "items": [
                    {
                        "type": 3,
                        "content": {
                            "version": "KqlItem/1.0",
                            "query": "Resources\n| where type in~ (\u0027microsoft.hybridcompute/machines\u0027,\u0027microsoft.compute/virtualmachines\u0027)\n| where \u0027*\u0027 in ({Subscription}) or subscriptionId in ({Subscription})\n| where \u0027*\u0027 in ({ResourceGroup}) or resourceGroup in ({ResourceGroup})\n| extend Scope = iff(type =~ \u0027microsoft.hybridcompute/machines\u0027, \u0027Arc\u0027, \u0027AzureVM\u0027)\n| extend OSTypeNorm = tolower(coalesce(tostring(properties.osName), tostring(properties.osType), tostring(properties.storageProfile.osDisk.osType)))\n| where \u0027*\u0027 in ({MachineScope}) or Scope in ({MachineScope})\n| where \u0027All\u0027 in ({OSType}) or (\u0027Windows\u0027 in ({OSType}) and OSTypeNorm has \u0027windows\u0027) or (\u0027Linux\u0027 in ({OSType}) and OSTypeNorm has \u0027linux\u0027)\n| project name, Scope, OSType = OSTypeNorm, location, resourceGroup, subscriptionId, id\n| order by name asc",
                            "size": 1,
                            "title": "Machine Inventory",
                            "queryType": 1,
                            "resourceType": "microsoft.resourcegraph/resources",
                            "crossComponentResources": [
                                "{Subscription}"
                            ],
                            "gridSettings": {
                                "formatters": [
                                    {
                                        "columnMatch": "id",
                                        "formatter": 13,
                                        "formatOptions": {
                                            "linkTarget": "Resource",
                                            "showIcon": true
                                        }
                                    }
                                ]
                            }
                        },
                        "name": "inv-grid"
                    },
                    {
                        "type": 3,
                        "content": {
                            "version": "KqlItem/1.0",
                            "query": "Heartbeat\n| summarize LastHeartbeat = max(TimeGenerated) by Computer, OSType, ResourceGroup, SubscriptionId\n| extend Status = iff(LastHeartbeat \u003e ago(15m), \u0027Online\u0027, \u0027Offline\u0027)\n| summarize Machines = count() by OSType, Status\n| order by Machines desc",
                            "size": 0,
                            "title": "Inventory by OS and Status",
                            "timeContextFromParameter": "timeRange",
                            "queryType": 0,
                            "resourceType": "microsoft.operationalinsights/workspaces",
                            "crossComponentResources": [
                                "{Workspace}"
                            ],
                            "visualization": "barchart"
                        },
                        "name": "inv-os-status"
                    }
                ]
            },
            "conditionalVisibility": {
                "parameterName": "selectedTab",
                "comparison": "isEqualTo",
                "value": "Inventory"
            },
            "name": "tab-inventory"
        },
        {
            "type": 12,
            "content": {
                "version": "NotebookGroup/1.0",
                "groupType": "editable",
                "title": "Patch Operations",
                "items": [
                    {
                        "type": 3,
                        "content": {
                            "version": "KqlItem/1.0",
                            "query": "union isfuzzy=true Update\n| summarize MissingUpdates = count() by Computer, Classification\n| order by MissingUpdates desc",
                            "size": 1,
                            "title": "Missing Updates by Machine",
                            "timeContextFromParameter": "timeRange",
                            "queryType": 0,
                            "resourceType": "microsoft.operationalinsights/workspaces",
                            "crossComponentResources": [
                                "{Workspace}"
                            ]
                        },
                        "name": "patch-missing"
                    },
                    {
                        "type": 3,
                        "content": {
                            "version": "KqlItem/1.0",
                            "query": "union isfuzzy=true UpdateSummary\n| extend Installed = tolong(column_ifexists(\u0027InstalledCount\u0027, 0)), Missing = tolong(column_ifexists(\u0027MissingCount\u0027, column_ifexists(\u0027TotalUpdatesMissing\u0027, 0)))\n| summarize Installed = sum(Installed), Missing = sum(Missing) by Computer\n| extend CompliancePercent = iff((Installed + Missing) == 0, real(null), round(100.0 * todouble(Installed) / todouble(Installed + Missing), 2))\n| project Computer, Installed, Missing, CompliancePercent\n| order by CompliancePercent asc",
                            "size": 0,
                            "title": "Patch Compliance by Machine",
                            "timeContextFromParameter": "timeRange",
                            "queryType": 0,
                            "resourceType": "microsoft.operationalinsights/workspaces",
                            "crossComponentResources": [
                                "{Workspace}"
                            ],
                            "visualization": "table"
                        },
                        "customWidth": "50",
                        "name": "patch-compliance"
                    },
                    {
                        "type": 3,
                        "content": {
                            "version": "KqlItem/1.0",
                            "query": "union isfuzzy=true Update\n| where Classification =~ \u0027Critical Updates\u0027 or Classification =~ \u0027Security Updates\u0027\n| summarize Missing = count() by Classification\n| order by Missing desc",
                            "size": 0,
                            "title": "Critical/Security Missing Updates",
                            "timeContextFromParameter": "timeRange",
                            "queryType": 0,
                            "resourceType": "microsoft.operationalinsights/workspaces",
                            "crossComponentResources": [
                                "{Workspace}"
                            ],
                            "visualization": "columnchart"
                        },
                        "customWidth": "50",
                        "name": "patch-critical"
                    }
                ]
            },
            "conditionalVisibility": {
                "parameterName": "selectedTab",
                "comparison": "isEqualTo",
                "value": "Patch"
            },
            "name": "tab-patch"
        },
        {
            "type": 12,
            "content": {
                "version": "NotebookGroup/1.0",
                "groupType": "editable",
                "title": "SQL Discovery",
                "items": [
                    {
                        "type": 3,
                        "content": {
                            "version": "KqlItem/1.0",
                            "query": "union isfuzzy=true ConfigurationData\n| where ConfigDataType == \u0027WindowsServices\u0027\n| extend ServiceNameNorm = tostring(coalesce(column_ifexists(\u0027ServiceName\u0027, \u0027\u0027), column_ifexists(\u0027Name\u0027, \u0027\u0027), column_ifexists(\u0027DisplayName\u0027, \u0027\u0027), column_ifexists(\u0027SvcName\u0027, \u0027\u0027)))\n| extend StateNorm = tostring(coalesce(column_ifexists(\u0027State\u0027, \u0027\u0027), column_ifexists(\u0027Status\u0027, \u0027Unknown\u0027)))\n| where ServiceNameNorm has \u0027MSSQL\u0027\n| summarize SQLServiceInstances = count() by Computer, ServiceName = ServiceNameNorm, State = StateNorm\n| order by SQLServiceInstances desc",
                            "size": 0,
                            "title": "Detected SQL Services (From Guest Inventory)",
                            "timeContextFromParameter": "timeRange",
                            "queryType": 0,
                            "resourceType": "microsoft.operationalinsights/workspaces",
                            "crossComponentResources": [
                                "{Workspace}"
                            ]
                        },
                        "name": "sql-services"
                    },
                    {
                        "type": 3,
                        "content": {
                            "version": "KqlItem/1.0",
                            "query": "union isfuzzy=true ConfigurationData\n| where ConfigDataType == \u0027Software\u0027\n| extend SoftwareNameNorm = tostring(coalesce(column_ifexists(\u0027SoftwareName\u0027, \u0027\u0027), column_ifexists(\u0027DisplayName\u0027, \u0027\u0027), column_ifexists(\u0027Name\u0027, \u0027\u0027)))\n| extend SoftwareVersionNorm = tostring(coalesce(column_ifexists(\u0027SoftwareVersion\u0027, \u0027Unknown\u0027), column_ifexists(\u0027Version\u0027, \u0027Unknown\u0027), column_ifexists(\u0027DisplayVersion\u0027, \u0027Unknown\u0027)))\n| where SoftwareNameNorm has \u0027SQL Server\u0027\n| summarize InstallCount = count() by SoftwareName = SoftwareNameNorm, SoftwareVersion = SoftwareVersionNorm\n| order by InstallCount desc",
                            "size": 0,
                            "title": "SQL Product Version Breakdown",
                            "timeContextFromParameter": "timeRange",
                            "queryType": 0,
                            "resourceType": "microsoft.operationalinsights/workspaces",
                            "crossComponentResources": [
                                "{Workspace}"
                            ],
                            "visualization": "barchart"
                        },
                        "customWidth": "50",
                        "name": "sql-version"
                    },
                    {
                        "type": 3,
                        "content": {
                            "version": "KqlItem/1.0",
                            "query": "Resources\n| where type =~ \u0027microsoft.azurearcdata/sqlserverinstances\u0027\n| where \u0027*\u0027 in ({Subscription}) or subscriptionId in ({Subscription})\n| where \u0027*\u0027 in ({ResourceGroup}) or resourceGroup in ({ResourceGroup})\n| project name, location, resourceGroup, subscriptionId, id\n| order by name asc",
                            "size": 0,
                            "title": "Arc-enabled SQL Server Resources",
                            "queryType": 1,
                            "resourceType": "microsoft.resourcegraph/resources",
                            "crossComponentResources": [
                                "{Subscription}"
                            ],
                            "gridSettings": {
                                "formatters": [
                                    {
                                        "columnMatch": "id",
                                        "formatter": 13,
                                        "formatOptions": {
                                            "linkTarget": "Resource",
                                            "showIcon": true
                                        }
                                    }
                                ]
                            }
                        },
                        "customWidth": "50",
                        "name": "sql-arc"
                    }
                ]
            },
            "conditionalVisibility": {
                "parameterName": "selectedTab",
                "comparison": "isEqualTo",
                "value": "SQL"
            },
            "name": "tab-sql"
        },
        {
            "type": 12,
            "content": {
                "version": "NotebookGroup/1.0",
                "groupType": "editable",
                "title": "Shadow IT Detection",
                "items": [
                    {
                        "type": 1,
                        "content": {
                            "json": "Use `DbKeywords` to tailor detection patterns. This section highlights non-standard DB software footprints discovered from guest inventory."
                        },
                        "name": "shadow-help"
                    },
                    {
                        "type": 3,
                        "content": {
                            "version": "KqlItem/1.0",
                            "query": "let Keywords = split(\u0027{DbKeywords}\u0027, \u0027,\u0027);\nunion isfuzzy=true ConfigurationData\n| where ConfigDataType == \u0027Software\u0027\n| extend SoftwareNameNorm = tostring(coalesce(column_ifexists(\u0027SoftwareName\u0027, \u0027\u0027), column_ifexists(\u0027DisplayName\u0027, \u0027\u0027), column_ifexists(\u0027Name\u0027, \u0027\u0027)))\n| extend SoftwareVersionNorm = tostring(coalesce(column_ifexists(\u0027SoftwareVersion\u0027, \u0027Unknown\u0027), column_ifexists(\u0027Version\u0027, \u0027Unknown\u0027), column_ifexists(\u0027DisplayVersion\u0027, \u0027Unknown\u0027)))\n| where SoftwareNameNorm has_any (Keywords)\n| project TimeGenerated, Computer, SoftwareName = SoftwareNameNorm, SoftwareVersion = SoftwareVersionNorm, Publisher\n| order by TimeGenerated desc",
                            "size": 1,
                            "title": "Potential Shadow DB Software",
                            "timeContextFromParameter": "timeRange",
                            "queryType": 0,
                            "resourceType": "microsoft.operationalinsights/workspaces",
                            "crossComponentResources": [
                                "{Workspace}"
                            ]
                        },
                        "name": "shadow-grid"
                    },
                    {
                        "type": 3,
                        "content": {
                            "version": "KqlItem/1.0",
                            "query": "union isfuzzy=true ConfigurationData\n| where ConfigDataType == \u0027Software\u0027\n| extend SoftwareNameNorm = tostring(coalesce(column_ifexists(\u0027SoftwareName\u0027, \u0027\u0027), column_ifexists(\u0027DisplayName\u0027, \u0027\u0027), column_ifexists(\u0027Name\u0027, \u0027\u0027)))\n| where TimeGenerated \u003e ago(7d)\n| summarize NewlyObserved = dcount(SoftwareNameNorm) by Computer\n| where NewlyObserved \u003e 0\n| order by NewlyObserved desc",
                            "size": 0,
                            "title": "Software Drift (Last 7 Days)",
                            "timeContextFromParameter": "timeRange",
                            "queryType": 0,
                            "resourceType": "microsoft.operationalinsights/workspaces",
                            "crossComponentResources": [
                                "{Workspace}"
                            ],
                            "visualization": "table"
                        },
                        "name": "shadow-drift"
                    }
                ]
            },
            "conditionalVisibility": {
