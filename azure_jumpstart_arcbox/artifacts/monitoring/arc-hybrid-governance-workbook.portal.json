{
    "version": "Notebook/1.0",
    "items": [
        {
            "type": 1,
            "content": {
                "json": "# Azure Arc Hybrid Inventory, Patching, SQL, and Shadow IT Workbook\n\nMAP-like continuous discovery and operations visibility for hybrid/on-prem assets onboarded to Azure Arc and Azure Monitor."
            },
            "name": "title"
        },
        {
            "type": 9,
            "content": {
                "version": "KqlParameterItem/1.0",
                "parameters": [
                    {
                        "id": "a8870ea2-1794-4c44-a656-f0bc47d35111",
                        "version": "KqlParameterItem/1.0",
                        "name": "Subscription",
                        "label": "Subscription",
                        "type": 6,
                        "isRequired": true,
                        "multiSelect": true,
                        "quote": "\u0027",
                        "delimiter": ",",
                        "query": "Resources\n| where type in~ (\u0027microsoft.hybridcompute/machines\u0027,\u0027microsoft.compute/virtualmachines\u0027)\n| summarize Count = count() by subscriptionId\n| order by Count desc\n| project value = subscriptionId, label = subscriptionId",
                        "crossComponentResources": [
                            "value::all"
                        ],
                        "queryType": 1,
                        "resourceType": "microsoft.resourcegraph/resources",
                        "value": [
                            "value::all"
                        ],
                        "typeSettings": {
                            "additionalResourceOptions": [
                                "value::all"
                            ],
                            "includeAll": true,
                            "showDefault": false
                        }
                    },
                    {
                        "id": "4af6c548-3e45-4408-aab7-31cfc3e910c5",
                        "version": "KqlParameterItem/1.0",
                        "name": "Workspace",
                        "label": "Log Analytics Workspace",
                        "type": 5,
                        "isRequired": true,
                        "multiSelect": true,
                        "quote": "\u0027",
                        "delimiter": ",",
                        "query": "where type =~ \u0027microsoft.operationalinsights/workspaces\u0027\n| summarize by id, name\n| order by name asc",
                        "crossComponentResources": [
                            "value::all"
                        ],
                        "value": [],
                        "typeSettings": {
                            "additionalResourceOptions": [],
                            "showDefault": false
                        },
                        "queryType": 1,
                        "resourceType": "microsoft.resourcegraph/resources"
                    },
                    {
                        "id": "88954246-b63a-4bf8-8e34-d5b8b242178f",
                        "version": "KqlParameterItem/1.0",
                        "name": "ResourceGroup",
                        "label": "Resource group",
                        "type": 2,
                        "isRequired": true,
                        "multiSelect": true,
                        "quote": "\u0027",
                        "delimiter": ",",
                        "query": "resourcecontainers\n| where type =~ \u0027microsoft.resources/subscriptions/resourcegroups\u0027\n| where \u0027*\u0027 in ({Subscription}) or subscriptionId in ({Subscription})\n| project value = name, label = name\n| order by label asc",
                        "crossComponentResources": [
                            "{Subscription}"
                        ],
                        "value": [
                            "value::all"
                        ],
                        "typeSettings": {
                            "additionalResourceOptions": [
                                "value::all"
                            ],
                            "selectAllValue": "*",
                            "showDefault": false
                        },
                        "queryType": 1,
                        "resourceType": "microsoft.resourcegraph/resources"
                    },
                    {
                        "id": "7e56b3a7-d160-4a15-ac36-31ad4f825f58",
                        "version": "KqlParameterItem/1.0",
                        "name": "MachineScope",
                        "label": "Machine scope",
                        "type": 2,
                        "isRequired": true,
                        "multiSelect": true,
                        "quote": "\u0027",
                        "delimiter": ",",
                        "value": [
                            "Arc"
                        ],
                        "jsonData": "[\n  { \"value\": \"Arc\", \"label\": \"Arc-enabled servers\", \"selected\": true },\n  { \"value\": \"AzureVM\", \"label\": \"Azure VMs\", \"selected\": false }\n]"
                    },
                    {
                        "id": "30bc205d-ed8d-4bb1-8581-95ef960f8a7f",
